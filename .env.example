# Gateway
PORT=8080

# Microservices Ports
AUTH_SERVICE_PORT=5001
ITEM_SERVICE_PORT=5002
MATCHING_SERVICE_PORT=5003
CLAIM_SERVICE_PORT=5004
NOTIFICATION_SERVICE_PORT=5005

# MongoDB URIs
MONGO_URI_AUTH=mongodb://localhost:27017/reclaim_auth
MONGO_URI_ITEM=mongodb://localhost:27017/reclaim_item
MONGO_URI_MATCHING=mongodb://localhost:27017/reclaim_matching
MONGO_URI_CLAIM=mongodb://localhost:27017/reclaim_claim
MONGO_URI_NOTIFICATION=mongodb://localhost:27017/reclaim_notification

# Security
JWT_SECRET=super_secret_development_key
